{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "自动生成新文章模板",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/article-template.mjs", "--poll"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false
      }
    }
  ]
}
